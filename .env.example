# Development defaults only. Generate unique values before running a standalone production server.
AGENTCTL_SESSION_KEY=dev-session-key-dev-session-key-123456
AGENTCTL_SESSION_SALT=dev-session-salt
PORT=3000
DATABASE_URL=sqlite.db

# Optional runtime tuning
# Use the platform path delimiter (: on Linux/macOS, ; on Windows).
AGENTCTL_WORKSPACE_SEARCH_PATHS=
AGENTCTL_CONTEXT_TURN_LIMIT=10
AGENTCTL_HANDOFF_RETENTION_MS=600000
AGENTCTL_STALE_HANDOFF_AGE_MS=86400000
AGENTCTL_AGENT_REQUEST_TIMEOUT_MS=60000
AGENTCTL_GIT_COMMAND_TIMEOUT_MS=3000
AGENTCTL_GIT_MAX_BUFFER_BYTES=262144
AGENTCTL_SESSION_MAX_AGE_SECONDS=86400
AGENTCTL_PAIRED_SESSION_MAX_AGE_SECONDS=2592000
AGENTCTL_EDITOR_CACHE_MS=60000

# Frontend
VITE_API_URL=http://localhost:3000

# Optional local OpenTelemetry traces, metrics and logs (pnpm telemetry:up starts Collector + Grafana).
# Disabled by default; use http/protobuf endpoints with any compatible backend.
AGENTCTL_TELEMETRY=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
AGENTCTL_TELEMETRY_SAMPLE_RATIO=1
