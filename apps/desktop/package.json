{
  "name": "@agentctl/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "AgentCtl Desktop Client",
  "desktopName": "agentctl",
  "author": {
    "name": "Youssef Boumlaki",
    "email": "boumlaki2002@gmail.com"
  },
  "homepage": "https://github.com/YoussefRnd/agentctl",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vp run watch",
    "build": "vp run compile",
    "preview": "electron-vite preview",
    "package": "vp run compile && electron-builder --config electron-builder.yml --publish never",
    "package:linux": "vp run compile && electron-builder --linux --config electron-builder.yml --publish never",
    "package:mac": "vp run compile && electron-builder --mac --config electron-builder.yml --publish never",
    "package:win": "vp run compile && electron-builder --win --config electron-builder.yml --publish never",
    "test": "vp test run --root ../.. apps/desktop --passWithNoTests",
    "typecheck": "vp run types"
  },
  "type": "commonjs",
  "dependencies": {
    "@agentctl/core": "workspace:*",
    "@agentctl/server": "workspace:*",
    "@agentctl/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "electron-updater": "^6.8.9",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@agentctl/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
