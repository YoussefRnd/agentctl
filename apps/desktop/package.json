{
  "name": "@agentctl/desktop",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "Youssef Boumlaki",
    "email": "boumlaki2002@gmail.com"
  },
  "homepage": "https://github.com/YoussefRnd/agentctl",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml --publish never",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "type": "commonjs",
  "dependencies": {
    "@agentctl/core": "workspace:*",
    "@agentctl/server": "workspace:*",
    "@agentctl/shared": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@agentctl/eslint-config": "workspace:*",
    "@agentctl/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.11"
  }
}
