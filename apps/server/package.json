    "@fastify/type-provider-zod": "^1.0.3",
    "@fastify/websocket": "^11.3.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
