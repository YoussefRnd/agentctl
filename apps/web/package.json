{
  "name": "@agentctl/web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "architecture:check": "pnpm --dir ../.. architecture:check",
    "build": "vp run compile",
    "dev": "vp run watch",
    "perf:build": "vp build --mode performance",
    "perf:preview": "vp preview --outDir dist-performance --port 4174",
    "perf:baseline": "node scripts/performance-browser.mjs",
    "perf:journeys": "node scripts/performance-browser.mjs --journeys --verify-deferred",
    "perf:test": "node --test --test-isolation=none scripts/performance-budgets.test.mjs",
    "perf:check": "node scripts/performance-check.mjs",
    "test": "vp test run --root ../.. apps/web",
    "typecheck": "vp run types"
  },
  "type": "module",
  "dependencies": {
    "@agentctl/api-client": "workspace:*",
    "@agentctl/shared": "workspace:*",
    "@agentctl/ui": "workspace:*",
    "@pierre/trees": "1.0.0-beta.6",
    "@primer/octicons-react": "^19.42.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "decode-named-character-reference": "^1.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "match-sorter": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.2",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@agentctl/tsconfig": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
