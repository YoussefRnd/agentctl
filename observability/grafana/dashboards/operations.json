{
  "uid": "agentctl-operations",
  "title": "AgentCtl operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["agentctl"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(agentctl_process_memory_bytes{service_name=~\"agentctl-.*\"}, service_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "agentctl-.*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Process instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(agentctl_process_memory_bytes{service_name=~\"$service\"}, service_instance_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "HTTP requests / second (completed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Long-lived SSE requests are counted when the connection closes.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "HTTP p95 by route (excluding SSE)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,http_route) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",service_instance_id=~\"$instance\",http_route!~\".*/stream\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "HTTP 5xx fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Healthy traffic with no 5xx responses shows zero. No traffic or insufficient samples may display no data.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",service_instance_id=~\"$instance\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "5xx fraction",
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Queue wait p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agentctl_queue_wait_duration_seconds_bucket{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "queue wait",
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Turn completion rate by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agentctl_turn_outcome) (rate(agentctl_turn_duration_seconds_count{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{agentctl_turn_outcome}}",
          "range": true
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Executor duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,agentctl_turn_outcome) (rate(agentctl_turn_duration_seconds_bucket{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{agentctl_turn_outcome}}",
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Turn phase p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Phase timings follow TurnDiagnostics; completion starts at dispatch. Provider/model time is included.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,agentctl_turn_phase) (rate(agentctl_turn_phase_duration_seconds_bucket{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{agentctl_turn_phase}}",
          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Connection lifecycle events / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Event counts, not the number of active connections.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agentctl_agent_event,agentctl_agent_adapter) (rate(agentctl_agent_connection_events_total{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{agentctl_agent_adapter}} {{agentctl_agent_event}}",
          "range": true
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Operational logs (trace IDs link to Tempo)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"} | service_instance_id =~ \"$instance\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Fixed operational events only. Trace IDs link through the provisioned Loki datasource. Unsampled traces may be absent.",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      }
    }
  ]
}
