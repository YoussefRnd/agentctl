{
  "name": "agentctl",
  "version": "0.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@agentctl/web... --filter=@agentctl/server...",
    "dev:desktop": "turbo dev --filter=@agentctl/desktop... --filter=!@agentctl/server --filter=@agentctl/ui... --filter=@agentctl/api-client...",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} + 2>/dev/null; find packages apps -name dist -type d -exec rm -rf {} + 2>/dev/null; find packages apps -name .turbo -type d -prune -exec rm -rf {} + 2>/dev/null; find packages apps -name 'tsconfig.tsbuildinfo' -type f -delete 2>/dev/null; rm -rf .turbo",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^25.9.8",
    "@typescript/native": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.4",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}": [
      "prettier --write"
    ]
  }
}
