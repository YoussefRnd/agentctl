{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@agentctl/desktop#build": {
      "dependsOn": ["^build", "@agentctl/web#build"],
      "outputs": ["out/**", "release/**", "drizzle/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/index.html",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/core/drizzle/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "XCURSOR_THEME",
        "XCURSOR_SIZE",
        "XDG_DATA_DIRS",
        "XDG_CONFIG_DIRS",
        "XDG_SESSION_TYPE",
        "XDG_CURRENT_DESKTOP",
        "DESKTOP_SESSION",
        "GNOME_DESKTOP_SESSION_ID",
        "KDE_FULL_SESSION",
        "WAYLAND_DISPLAY",
        "DISPLAY",
        "XAUTHORITY"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.js",
        "$TURBO_ROOT$/apps/web/src/test-setup.ts"
      ]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    "vitest.config.js",
    "packages/tsconfig/**",
    "scripts/architecture/**"
  ]
}
