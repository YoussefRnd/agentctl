{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@agentctl/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "release/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "XCURSOR_THEME",
        "XCURSOR_SIZE",
        "XDG_DATA_DIRS",
        "XDG_CONFIG_DIRS",
        "XDG_SESSION_TYPE",
        "XDG_CURRENT_DESKTOP",
        "DESKTOP_SESSION",
        "GNOME_DESKTOP_SESSION_ID",
        "KDE_FULL_SESSION",
        "WAYLAND_DISPLAY",
        "DISPLAY",
        "XAUTHORITY"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
