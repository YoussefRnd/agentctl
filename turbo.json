{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@agentctl/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "release/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },

    "clean": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
